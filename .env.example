# ============================================================
# PawPal environment settings
# Copy this file to ".env" and fill in what you have.
# Everything is OPTIONAL — PawPal runs with none of these set.
# ============================================================

# --- App ---
PORT=3000
# The public address of the site (used in email links)
APP_URL=http://localhost:3000
# Long random string used to sign login tokens. CHANGE THIS before deploying.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (MongoDB Atlas) ---
# Leave empty to use the built-in file database (data/pawpal-db.json).
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=pawpal

# --- Email (Nodemailer / SMTP) ---
# Leave SMTP_HOST empty for "dev mailbox" mode: emails are shown at /dev-mailbox.html
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#                SMTP_USER=you@gmail.com   SMTP_PASS=<16-char Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PawPal <no-reply@pawpal.app>"

# --- AI (OpenAI) ---
# Leave empty to use PawPal's built-in rule-based AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Maps (vet finder) ---
# Needs "Places API (New)" and "Maps Embed API" enabled in Google Cloud.
# Leave empty to use the free keyless Google Maps embed.
GOOGLE_MAPS_API_KEY=

# --- Demo tools ---
# Allows staff to reset all data back to the sample data from the Settings page.
ALLOW_DEMO_RESET=true
